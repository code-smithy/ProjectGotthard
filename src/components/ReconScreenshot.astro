---
import { Image } from 'astro:assets';
import reconReport from '../assets/images/recon-mission-report.png';
import olderReconReport from '../assets/images/recon-report-old.png';
interface Props { missionPlanning?: boolean }
const { missionPlanning = false } = Astro.props;
const screenshot = missionPlanning ? olderReconReport : reconReport;
---
<figure class="game-screenshot">
  <a href={screenshot.src} aria-label="View the recon mission report screenshot at full size">
    <Image src={screenshot} alt={missionPlanning ? 'An earlier recon report available during mission preparation, providing intelligence to review before sending a team through the Transit Gate.' : 'In-game communications window showing a recon mission report with a received terrain image and atmospheric readings on the command workstation.'} widths={[640, 960, 1280, 1920]} sizes="(max-width: 760px) 100vw, 1240px" format="webp" />
  </a>
  <figcaption>{missionPlanning ? 'Recon report review · Mission preparation · In-game screenshot · Work in progress' : 'Recon mission report · In-game screenshot · Work in progress'}</figcaption>
</figure>
<style>
  .game-screenshot { margin: 0; min-width: 0; }
  a { display: block; }
  img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 12px; color: var(--muted); }
</style>
