---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { publicPosts } from '../../lib/posts';
import { path } from '../../lib/urls';
export async function getStaticPaths() {
  const posts = await publicPosts();
  return [...new Set(posts.flatMap(post => post.data.tags))].sort().map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`${tag.charAt(0).toUpperCase() + tag.slice(1)} reports`}><div class="container page-content"><header class="page-intro"><p class="eyebrow">Topic archive</p><h1>{tag.charAt(0).toUpperCase() + tag.slice(1)}</h1><p class="lead">Reports filed under {tag}.</p><a class="text-link" href={path('devlog/')}>← All development reports</a></header><div class="post-grid">{posts.map((post, index) => <PostCard post={post} index={index + 1} />)}</div></div></BaseLayout>
