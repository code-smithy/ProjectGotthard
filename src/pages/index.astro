---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlpineDiagram from '../components/AlpineDiagram.astro';
import PostCard from '../components/PostCard.astro';
import { publicPosts } from '../lib/posts';
import { path } from '../lib/urls';
const posts = (await publicPosts()).slice(0, 3);
---
<BaseLayout title="Project Gotthard">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> Independent game · Development journal</p><h1>Beyond the mountain.<br /><em>Under your command.</em></h1><p class="hero-lead">October 1994. Beneath the Swiss Alps, a European military programme opens the way to worlds beyond Earth. You are its commander.</p><p class="hero-motto">Send the teams. Weigh the risks.<br />Live with the consequences.</p><div class="actions"><a class="button" href={path('about/')}>Explore the game <span aria-hidden="true">↗</span></a><a class="text-link" href={path('devlog/')}>Read the devlog <span aria-hidden="true">→</span></a></div></div><AlpineDiagram /></div><div class="hero-strip container"><span>PROJECT GOTTHARD</span><span>Science fiction / Command / Management</span><span>01 — Programme overview</span></div></section>
  <section class="container section"><div class="section-heading"><div><p class="eyebrow">The commander's perspective</p><h2>Command, don't micromanage.</h2></div><p>A programme to run. People to bring home.<br />Decisions that reach beyond the next mission.</p></div><div class="feature-grid"><article><span class="index">01 / EXPEDITIONS</span><h3>Send people into the unknown.</h3><p>Prepare teams, weigh the available information and give the orders. Your place is at command.</p></article><article><span class="index">02 / THE PROGRAMME</span><h3>Look beyond the mission.</h3><p>Personnel, research and security are part of the same responsibility. Every expedition belongs to a larger effort.</p></article><article><span class="index">03 / CONSEQUENCES</span><h3>Decide with an incomplete picture.</h3><p>Reports arrive. Situations develop. Choose a response knowing that certainty may come too late.</p></article></div><p class="small-note">The intended experience. Individual systems and their development status will be documented in the journal.</p></section>
  <section class="setting-section"><div class="container setting-grid"><div><p class="eyebrow">An alternate October 1994</p><h2>A world behind<br />the mountain.</h2></div><div><p>Deep in the Alps, a classified European programme stands at the edge of an extraordinary discovery. The world outside is familiar. What lies ahead is not.</p><p>Project Gotthard is an independent science-fiction command and management game about the people, preparation and difficult choices behind exploration.</p><a class="text-link" href={path('about/')}>Read the programme briefing →</a></div></div></section>
  <section class="container section"><div class="section-heading"><div><p class="eyebrow">The Gotthard Files</p><h2>From the development desk.</h2></div><a class="text-link" href={path('devlog/')}>All reports →</a></div><div class="post-grid">{posts.map((post, index) => <PostCard post={post} index={index + 1} headingLevel={3} />)}</div></section>
</BaseLayout>

