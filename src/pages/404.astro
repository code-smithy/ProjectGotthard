---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path } from '../lib/urls';
---
<BaseLayout title="File not found"><div class="container page-content"><header class="page-intro"><p class="eyebrow">Archive reference / 404</p><h1>This file isn't here.</h1><p class="lead">The address may have changed, or the report may not have been published.</p><div class="actions"><a class="button" href={path()}>Return to programme overview →</a><a class="text-link" href={path('devlog/')}>Browse the devlog</a></div></header></div></BaseLayout>
