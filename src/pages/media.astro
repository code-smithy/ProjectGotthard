---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReconScreenshot from '../components/ReconScreenshot.astro';
import { path } from '../lib/urls';
---
<BaseLayout title="Media" description="In-game screenshots from Project Gotthard, beginning with a recon mission report on the command workstation.">
  <div class="container page-content">
    <header class="page-intro">
      <p class="eyebrow">Visual archive / 02</p>
      <h1>From inside the mountain.</h1>
      <p class="lead">A look inside Project Gotthard, through screenshots from the game in development.</p>
    </header>
    <ReconScreenshot />
    <div class="prose">
      <h2>Recon mission report</h2>
      <p>A recon mission report, viewed through the command workstation's communications inbox. A received terrain image and environmental readings offer a first glimpse of the world beyond the gate.</p>
      <p><strong>Work in progress.</strong> This screenshot shows the game during development. The interface, visual style and graphics are subject to change as development continues.</p>
      <a class="text-link" href={path('devlog/')}>Read the development journal →</a>
    </div>
  </div>
</BaseLayout>
