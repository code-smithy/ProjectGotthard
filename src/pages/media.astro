---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReconScreenshot from '../components/ReconScreenshot.astro';
import { path } from '../lib/urls';
import { Image } from 'astro:assets';
import commandCalendar from '../assets/images/command-calendar-weekly-view.png';
import missionTeam from '../assets/images/mission-team-people.png';
const screenshots = [
  {
    image: commandCalendar,
    title: 'Command calendar — weekly view',
    alt: 'The command calendar in its weekly view, showing the programme schedule.',
    description: 'An Outlook-style calendar brings the programme’s schedule into the commander’s office, weekends included. A View from Space explores the management perspective behind the game: keeping track of teams and considering how their activities affect the wider programme.',
    article: 'a-view-from-space',
    articleTitle: 'A View from Space',
  },
  {
    image: missionTeam,
    title: 'The people behind a Transit Detachment',
    alt: 'Team member selection during mission preparation, with placeholder personnel portraits.',
    description: 'Transit Detachments draw on military and civilian personnel to meet a mission’s skill requirements. A team usually has four members; a fifth can bring a specialist along without breaking up the existing team and risking its cohesion. The portraits shown here are placeholders.',
    article: 'going-on-a-mission',
    articleTitle: 'Going on a mission',
  },
];
---
<BaseLayout title="Media" description="Project Gotthard logos and in-game screenshots, including a recon mission report on the command workstation.">
  <div class="container page-content">
    <header class="page-intro">
      <p class="eyebrow">Visual archive / 02</p>
      <h1>From inside the mountain.</h1>
      <p class="lead">A look inside Project Gotthard, through its insignia and screenshots from the game in development.</p>
    </header>
    <section class="logo-archive" aria-labelledby="logo-heading">
      <div class="logo-preview"><img src={path('branding/gotthard-geometric-transparent.svg')} width="1060" height="1060" alt="Project Gotthard logo: a split triangular insignia surrounding a compass star, above the wordmark and a red underline" /></div>
      <div><p class="eyebrow">Programme identity</p><h2 id="logo-heading">Project Gotthard logo</h2><p>The geometric insignia and wordmark, available with a solid or transparent background.</p>
        <ul class="logo-downloads">
          <li><a href={path('branding/gotthard-geometric.svg')} download>Logo — SVG</a> / <a href={path('branding/gotthard-geometric.png')} download>PNG</a></li>
          <li><a href={path('branding/gotthard-geometric-transparent.svg')} download>Transparent — SVG</a> / <a href={path('branding/gotthard-geometric-transparent.png')} download>PNG</a></li>
          <li><a href={path('branding/gotthard-geometric-editable-text.svg')} download>Editable text — SVG</a></li>
        </ul>
      </div>
    </section>
    <ReconScreenshot />
    <div class="prose">
      <h2>Recon mission report</h2>
      <p>A recon mission report, viewed through the command workstation's communications inbox. A received terrain image and environmental readings offer a first glimpse of the world beyond the gate.</p>
      <p><strong>Work in progress.</strong> This screenshot shows the game during development. The interface, visual style and graphics are subject to change as development continues.</p>
      <a class="text-link" href={path('devlog/')}>Read the development journal →</a>
    </div>
    <section class="screenshot-entry" aria-labelledby="recon-review-heading">
      <ReconScreenshot missionPlanning />
      <div class="prose">
        <h2 id="recon-review-heading">Reviewing earlier recon</h2>
        <p>Before committing a team, review the intelligence already available. In Going on a mission, this report is about two weeks old: sending another FERRET recon vehicle could refresh the picture, provide sensor readings and support communications as a relay.</p>
        <p><strong>In-game screenshot · Work in progress.</strong> The interface, visual style and graphics may change.</p>
        <a class="text-link" href={path('devlog/going-on-a-mission/')}>Read Going on a mission →</a>
      </div>
    </section>
    {screenshots.map(({ image, title, alt, description, article, articleTitle }) => (
      <section class="screenshot-entry">
        <figure>
          <a href={image.src} aria-label={`View ${title.toLowerCase()} at full size`}>
            <Image src={image} alt={alt} widths={[640, 960, 1280, 1920]} sizes="(max-width: 760px) 100vw, 1240px" format="webp" />
          </a>
          <figcaption>{title} · In-game screenshot · Work in progress</figcaption>
        </figure>
        <div class="prose">
          <h2>{title}</h2>
          <p>{description}</p>
          <p><strong>Work in progress.</strong> The interface, visual style and graphics may change.</p>
          <a class="text-link" href={path(`devlog/${article}/`)}>Read {articleTitle} →</a>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
<style>
  .screenshot-entry { margin-top: 48px; }
  figure { margin: 0; min-width: 0; }
  figure a { display: block; }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 12px; color: var(--muted); }
</style>
