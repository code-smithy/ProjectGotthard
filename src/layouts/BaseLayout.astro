---
import '../styles/global.css';
import { path } from '../lib/urls';
import { links } from '../data/links';
interface Props { title: string; description?: string; article?: boolean }
const { title, description = 'A development journal for Project Gotthard, an independent science-fiction command game set in an alternate 1994.', article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['The game', 'about/'], ['Devlog', 'devlog/'], ['Media', 'media/'], ['Roadmap', 'roadmap/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The Gotthard Files</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="The Gotthard Files" href={path('rss.xml')} />
    <meta property="og:title" content={`${title} · The Gotthard Files`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#101b29" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={path()} aria-label="Project Gotthard home"><span class="brand-mark" aria-hidden="true">△</span><span>PROJECT GOTTHARD<small>THE GOTTHARD FILES</small></span></a>
        <nav aria-label="Primary navigation">{nav.map(([label, route]) => <a href={path(route)} aria-current={Astro.url.pathname.startsWith(path(route)) ? 'page' : undefined}>{label}</a>)}</nav>
        <a class="header-follow" href={path('devlog/')}>Follow development <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <section class="follow-section"><div class="container follow-inner"><div><p class="eyebrow">Keep the file open</p><h2>Follow the programme.</h2><p>New reports, design notes and a closer look behind the mountain.</p></div><div class="actions"><a class="button" href={path('rss.xml')}>Subscribe via RSS <span aria-hidden="true">↗</span></a>{links.community && <a class="text-link" href={links.community}>Join the community ↗</a>}{links.storefront && <a class="text-link" href={links.storefront}>Visit the store ↗</a>}</div></div></section>
    <footer class="site-footer container"><div class="footer-top"><a class="brand" href={path()}>PROJECT GOTTHARD</a><p>An independent, original science-fiction game.</p></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} Project Gotthard</span><span>Development in progress · Release date unannounced</span><a href={path('rss.xml')}>RSS feed</a></div></footer>
  </body>
</html>
