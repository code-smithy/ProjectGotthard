---
import '../styles/global.css';
import { path } from '../lib/urls';
import { links } from '../data/links';
interface Props { title: string; description?: string; article?: boolean }
const { title, description = 'A development journal for Project Gotthard, an independent science-fiction command game set in an alternate 1994.', article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [['The game', 'about/'], ['Devlog', 'devlog/'], ['Media', 'media/'], ['Roadmap', 'roadmap/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The Gotthard Files</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="The Gotthard Files" href={path('rss.xml')} />
    <meta property="og:title" content={`${title} · The Gotthard Files`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(path('branding/gotthard-geometric.png'), Astro.site)} />
    <meta property="og:image:alt" content="Project Gotthard geometric insignia and wordmark" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={new URL(path('branding/gotthard-geometric.png'), Astro.site)} />
    <meta name="twitter:image:alt" content="Project Gotthard geometric insignia and wordmark" />
    <meta name="theme-color" content="#0b100c" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={path()} aria-label="Project Gotthard home"><img class="brand-mark" src={path('branding/gotthard-insignia.svg')} width="56" height="40" alt="" /><span>PROJECT GOTTHARD<small>THE GOTTHARD FILES</small></span></a>
        <nav aria-label="Primary navigation">{nav.map(([label, route]) => <a href={path(route)} aria-current={Astro.url.pathname.startsWith(path(route)) ? 'page' : undefined}>{label}</a>)}</nav>
        <div class="header-socials" role="group" aria-label="Follow Project Gotthard">
          {links.youtube && <a class="social-logo" href={links.youtube} aria-label="Project Gotthard on YouTube" title="YouTube">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" /></svg>
          </a>}
          {links.x && <a class="social-logo" href={links.x} aria-label="Project Gotthard on X" title="X">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.835L0 1.154h7.594l5.243 6.932 6.064-6.933Zm-1.29 19.49h2.039L6.487 3.24H4.3l13.31 17.403Z" /></svg>
          </a>}
        </div>
        <a class="header-follow" href={path('devlog/')}>Follow development <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <section class="follow-section"><div class="container follow-inner"><div><p class="eyebrow">Keep the file open</p><h2>Follow the programme.</h2><p>New reports, design notes and a closer look behind the mountain.</p></div><div class="actions"><a class="button" href={path('rss.xml')}>Subscribe via RSS <span aria-hidden="true">↗</span></a>{links.youtube && <a class="text-link" href={links.youtube}>YouTube <span aria-hidden="true">↗</span></a>}{links.x && <a class="text-link" href={links.x}>X <span aria-hidden="true">↗</span></a>}{links.community && <a class="text-link" href={links.community}>Join the community ↗</a>}{links.storefront && <a class="text-link" href={links.storefront}>Visit the store ↗</a>}</div></div></section>
    <footer class="site-footer container"><div class="footer-top"><a class="brand" href={path()}><img class="brand-mark" src={path('branding/gotthard-insignia.svg')} width="56" height="40" alt="" />PROJECT GOTTHARD</a><p>An independent, original science-fiction game.</p></div><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} Project Gotthard</span><span>Development in progress · Release date unannounced</span><a href={path('rss.xml')}>RSS feed</a></div></footer>
  </body>
</html>
